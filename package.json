{
  "name": "superguide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && pnpm -r --filter @superguide/widget --filter @superguide/console run build",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "node tools/scripts/pg-dev.mjs start",
    "db:stop": "node tools/scripts/pg-dev.mjs stop",
    "db:migrate": "node --env-file-if-exists=.env --import tsx apps/control-plane/src/db/migrate-cli.ts",
    "db:reset": "node tools/scripts/pg-dev.mjs reset",
    "test:unit": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --project unit",
    "test:integration": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --project integration",
    "test:security": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --project security",
    "test:e2e": "playwright test",
    "eval": "node --env-file-if-exists=.env --import tsx eval/harness/src/cli.ts",
    "check:forbidden": "node tools/scripts/check-forbidden.mjs",
    "check:bundle-boundary": "node tools/scripts/check-bundle-boundary.mjs",
    "test:unit:coverage": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --project unit --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-superguide": "workspace:*",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "@types/pg": "^8.15.5",
    "zod": "^4.4.3",
    "jose": "^6.2.10",
    "yaml": "^2.9.0",
    "fastify": "^5.12.1",
    "@anthropic-ai/sdk": "^0.120.0",
    "pino": "^10.3.1",
    "@superguide/contract": "workspace:*",
    "@superguide/policy": "workspace:*",
    "@superguide/procedures": "workspace:*",
    "@superguide/observer": "workspace:*",
    "@superguide/executor": "workspace:*",
    "@superguide/client-core": "workspace:*",
    "@superguide/widget-ui": "workspace:*",
    "jsdom": "^26.1.0",
    "@types/jsdom": "^21.1.7"
  }
}
