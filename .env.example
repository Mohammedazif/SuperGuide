# Copy this file to .env, then fill in the blanks.
# `pnpm env:init` does both: it writes .env and generates the three keys for you.
#
# Every variable here is validated by a Zod schema at process start, and the process
# exits non-zero if the environment is wrong. Blank values below are blank on purpose:
# a shared key committed to a repository is a key everybody has.

# Local development database, matching tools/scripts/bootstrap-roles.sql.
# The application role owns no table and holds no BYPASSRLS; the migration role owns the schema.
SG_DATABASE_URL=postgres://sg_app:sg_app_dev@127.0.0.1:55432/superguide
SG_MIGRATION_DATABASE_URL=postgres://sg_migrator:sg_migrator_dev@127.0.0.1:55432/superguide

SG_PORT=8080
SG_PUBLIC_ORIGIN=http://127.0.0.1:8080

# Which vendor serves the planner and classifier: anthropic, openai, or gemini.
# Only the key for the selected provider must be set.
SG_MODEL_PROVIDER=anthropic

# From the Anthropic console.
ANTHROPIC_API_KEY=
# From the OpenAI dashboard, used when SG_MODEL_PROVIDER=openai.
OPENAI_API_KEY=
# From Google AI Studio, used when SG_MODEL_PROVIDER=gemini.
GEMINI_API_KEY=

# 32 random bytes, base64: `openssl rand -base64 32`
SG_SESSION_SIGNING_KEY=
SG_SECRET_ENCRYPTION_KEY=
SG_WEBHOOK_SIGNING_KEY=

SG_ENABLE_GROUNDED_ACTIONS=false
SG_STEP_BUDGET=12
SG_LOG_LEVEL=info

# Extension surface (SuperGuide Anywhere). The widget does not use these.
SG_DEVICE_SIGNING_KEY=
SG_DAILY_TASK_QUOTA=20
SG_DAILY_IP_QUOTA=200
SG_ALLOWED_EXTENSION_IDS=chrome-extension://ghdcebndlanhmdeajdbbemcaihpenhoj
SG_ANYWHERE_AGENT=on
SG_ADAPTERS=on
