# Render Environment (not for local). Paste into the service Environment tab.
# Do not copy .env. Do not set SG_PORT or SG_PUBLIC_ORIGIN (Render injects PORT
# and RENDER_EXTERNAL_URL). Copy the four signing keys from your local .env.

# Render cannot reach db.<ref>.supabase.co (IPv6). Use Session pooler from
# Supabase → Connect: host *.pooler.supabase.com, port 5432 (not 6543).
# User is role.PROJECT_REF. Encode @ in passwords as %40.
SG_DATABASE_URL=postgresql://sg_app.PROJECT:SG_APP_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SG_MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

SG_MODEL_PROVIDER=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Copy these four values from local .env (pnpm env:init).
SG_SESSION_SIGNING_KEY=
SG_SECRET_ENCRYPTION_KEY=
SG_WEBHOOK_SIGNING_KEY=
SG_DEVICE_SIGNING_KEY=

SG_BOOTSTRAP_ROLES=1
SG_ENABLE_GROUNDED_ACTIONS=false
SG_STEP_BUDGET=12
SG_LOG_LEVEL=info
SG_DAILY_TASK_QUOTA=20
SG_DAILY_IP_QUOTA=200
SG_ANYWHERE_AGENT=on
SG_ADAPTERS=on
SG_ALLOWED_EXTENSION_IDS=chrome-extension://ghdcebndlanhmdeajdbbemcaihpenhoj
